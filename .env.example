# SnapLink Environment Variables
# Copy this file to .env and fill in the values

# ─── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/snaplink?schema=public"

# ─── Application ───────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SnapLink"
NEXT_PUBLIC_APP_DOMAIN="snaplink.app"

# ─── Authentication ────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ─── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# ─── Admin ─────────────────────────────────────────────
ADMIN_EMAIL="admin@snaplink.app"

# ─── Analytics ─────────────────────────────────────────
ENABLE_ANALYTICS="true"
